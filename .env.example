# Copy values into environment variables or .streamlit/secrets.toml.
# Never put real tokens in source control.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
NEWS_DETAIL_LIMIT=3
DART_API_KEY=
KRX_ID=
KRX_PW=

# Keep TLS verification enabled. If the company proxy re-signs certificates,
# prefer REQUESTS_CA_BUNDLE with the company CA over disabling verification.
VERIFY_SSL=true
REQUESTS_CA_BUNDLE=

FUND_MANAGER_DB=data/fund_manager.db
PRICE_LOOKBACK_DAYS=800
SCAN_MAX_WORKERS=6
MIN_MARKET_CAP=50000000000
MIN_DAILY_AMOUNT=1000000000
COMMISSION_BPS=15
SLIPPAGE_BPS=10
HOLDING_DAYS=5
ACCOUNT_EQUITY=100000000
RISK_PER_TRADE=0.0075
MAX_POSITION_PCT=0.15
MAX_SECTOR_PCT=0.30
MAX_PORTFOLIO_RISK=0.04
LIQUIDITY_PARTICIPATION=0.02
